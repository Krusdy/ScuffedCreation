import spotipy
import requests
import re
import webbrowser

CLIENT_ID = "64678fd12d87419a80ae7437423653f5"
CLIENT_SECRET = "27afcc225c694a36b0e4ce0bc8ea5857"
REDIRECT_URI = "https://oauth.pstmn.io/v1/callback"
SCOPE = "playlist-read-private playlist-read-collaborative user-library-read"

try:
    PROFILE_URL = input("Paste Spotify link: ").strip()
    entity_id = PROFILE_URL.split("/")[-1].split("?")[0]

    auth_url = (
        f"https://accounts.spotify.com/authorize?client_id={CLIENT_ID}"
        f"&response_type=code&redirect_uri={REDIRECT_URI}&scope={SCOPE}"
    )
    webbrowser.open(auth_url)
    redirected_url = input("After authorizing, paste the full redirected URL here: ").strip()

    if "code=" not in redirected_url:
        raise ValueError("The redirected URL is missing the authorization code. Make sure you pasted the full URL after authorizing.")

    code = redirected_url.split("code=")[1].split("&")[0]

    token_data = {
        "grant_type": "authorization_code",
        "code": code,
        "redirect_uri": REDIRECT_URI,
        "client_id": CLIENT_ID,
        "client_secret": CLIENT_SECRET
    }
    response = requests.post("https://accounts.spotify.com/api/token", data=token_data)
    response.raise_for_status()
    access_token = response.json().get("access_token")
    if not access_token:
        raise ValueError("Failed to obtain access token.")

    sp = spotipy.Spotify(auth=access_token)

    if "/artist/" in PROFILE_URL:
        entity_info = sp.artist(entity_id)
    elif "/user/" in PROFILE_URL:
        entity_info = sp.user(entity_id)
    else:
        raise ValueError("Unsupported Spotify link")

    entity_name = re.sub(r'[\\/*?:"<>|]', "", entity_info.get('display_name', entity_info.get('name', 'output')))
    OUTPUT_FILE = f"{entity_name}.txt"

    with open(OUTPUT_FILE, "w", encoding="utf-8") as f:
        if "/user/" in PROFILE_URL:
            playlists = sp.user_playlists(entity_id)
            while playlists:
                for playlist in playlists['items']:
                    f.write(f"{playlist['name']} - {playlist['external_urls']['spotify']}\n")
                playlists = sp.next(playlists) if playlists['next'] else None
        elif "/artist/" in PROFILE_URL:
            results = sp.artist_albums(entity_id, album_type='album,single', limit=50)
            albums = results['items']
            while results['next']:
                results = sp.next(results)
                albums.extend(results['items'])
            for album in albums:
                f.write(f"{album['name']} - {album['external_urls']['spotify']}\n")

    print(f"Done! Saved to {OUTPUT_FILE}")

except requests.exceptions.RequestException as e:
    print("Network error:", e)
except spotipy.exceptions.SpotifyException as e:
    print("Spotify API error:", e)
except ValueError as e:
    print("Error:", e)
except Exception as e:
    print("Unexpected error:", e)
